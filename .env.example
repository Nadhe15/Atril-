# Variables de entorno para ATRIL v5.0 (FundaOboeHJK)
# Copiar este archivo a .env y colocar credenciales del proyecto Supabase de pruebas/staging.
# REGLA DE SEGURIDAD (DoD #10): Nunca subir valores reales ni claves privadas al repositorio.

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto-pruebas.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.clave_sintetica_ejemplo

# Variables Operativas y Observabilidad Mínima (Laboratorio 7 / DoD #20)
ATRIL_ENV=staging
ATRIL_PORT=8081
ATRIL_LOG_LEVEL=info
ATRIL_LOG_FILE=logs/atril-staging.ndjson
# Habilitar en 1 únicamente en pruebas controladas de campo en staging (0 por defecto)
ATRIL_ENABLE_FIELD_TEST=0
